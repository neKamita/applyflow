  "narrative": {
    "northStar": "The Stamped Passport",
    "overview": "An application is a document that collects verified marks, the way a passport collects entry stamps.\nThe interface is a working tool first: a standard header, filters, lists and forms that a student on a\nphone understands without thinking. The world shows up in four places only: the cover-ink header with\nits guilloche band, the cool security-paper pages, a calm sans-serif voice, and stamps that carry\napplication status.\n\nNothing is stamped early. A stamp appears only when the backend has confirmed the state it shows, so\nthe student can trust what they see while they wait. Density is moderate: rows are scannable, controls\nare 44px tall, and there is no decoration in the work area beyond what carries meaning.",
    "keyCharacteristics": [
      "Committed shell colour: the deep blue-green cover owns the header on every page.",
      "Cool paper, never cream; ink is a tinted near-black, never pure black.",
      "Status is a stamp: ink colour plus a distinct shape.",
      "One authored motion: the stamp pressing onto the page.",
      "Fully bilingual type (Latin and Cyrillic), self-hosted."
    ],
    "rules": [
      {
        "name": "The Earned Ink Rule",
        "body": "Stamp inks appear only where they report a real status or error. They are never used for decoration, links or emphasis.",
        "section": "colors"
      },
      {
        "name": "The No Black Rule",
        "body": "No pure black or white anywhere; every neutral carries the cover's hue.",
        "section": "colors"
      },
      {
        "name": "The Machine Print Rule",
        "body": "Monospace is for references and stamp text only, never for headings or labels.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Fees, dates and counts use tabular numerals so columns line up.",
        "section": "typography"
      },
      {
        "name": "The One Elevation Rule",
        "body": "A surface declares depth once: a border or a shadow, never both.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the header in Passport Cover with the guilloche band on every page.",
      "Do show status with `StatusBadge` or `Stamp` so shape and ink always travel together.",
      "Do keep every text pair at 4.5:1 and every control border at 3:1 in both themes; add new pairs to",
      "Do use Golos Text for all interface text and keep inputs at 16px or larger."
    ],
    "donts": [
      "Don't stamp a state before the backend confirms it, and don't animate anything except a newly",
      "Don't use cream or warm paper, pure black, or gradient text.",
      "Don't nest panels or use a coloured side border on cards, alerts or list items.",
      "Don't use monospace for headings, labels or \"technical\" decoration.",
      "Don't add guilloche or other security patterns inside the work area; the band belongs to the cover."
    ]
  }
}